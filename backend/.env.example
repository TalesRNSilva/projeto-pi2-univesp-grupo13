# Copie este arquivo para ".env" e preencha com os dados reais do banco.
# NUNCA commite o ".env" real (ele já está no .gitignore).
DATABASE_HOST=hostname_do_banco
DATABASE_PORT=3306
DATABASE_USER=usuario_do_banco
DATABASE_PASSWORD=senha_do_banco
DATABASE_NAME=nome_do_banco
DATABASE_SSL_CA=ca.pem
SQLALCHEMY_ECHO=false
